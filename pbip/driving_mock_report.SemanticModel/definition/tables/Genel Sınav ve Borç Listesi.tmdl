table 'Genel Sınav ve Borç Listesi'
	lineageTag: 33a9eb1d-366b-4680-b59e-b430ee47109d

	measure 'Garantili Aday Sayısı' = ```
			
			CALCULATE(
			    [Aday Sayısı], 
			    CROSSFILTER('Kursiyer Listesi'[ADAY NO],'Genel Sınav ve Borç Listesi'[ADAY NO],Both)
			)
			```
		formatString: 0
		lineageTag: 678eeb8b-cf8d-494f-8a0e-af839c9e3dc4

		changedProperty = IsHidden

	measure 'ÖY Sertifika Alamayan Kişi Sayısı' =
			
			CALCULATE(
			    COUNT('Genel Sınav ve Borç Listesi'[Sertifika aldı mı?]),
			    'Genel Sınav ve Borç Listesi'[Sertifika aldı mı?] = "Almadı",
			    DATEADD('Takvim'[Date],-1,MONTH)
			)
		formatString: 0
		lineageTag: eb108a08-cf7a-4744-9f15-37e224780b76

		changedProperty = IsHidden

	measure 'Sertifika Alamayan Kişi Sayısı' =
			
			CALCULATE(
			    COUNT('Genel Sınav ve Borç Listesi'[Sertifika aldı mı?]),
			    'Genel Sınav ve Borç Listesi'[Sertifika aldı mı?] = "Not Certified"
			)
		formatString: 0
		lineageTag: 210d4490-7065-4131-a071-3f1e9b716863

		changedProperty = IsHidden

	measure 'Sertifika Alan' =
			CALCULATE( DISTINCTCOUNT('Genel Sınav ve Borç Listesi'[ADAY NO]),
			'Genel Sınav ve Borç Listesi'[Sertifika aldı mı?] = "Certified")
		formatString: 0
		lineageTag: 29c860a5-e829-4e98-927d-8134f0ef2f5e

		changedProperty = IsHidden

