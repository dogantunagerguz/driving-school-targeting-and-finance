table 'Gider Listesi'
	lineageTag: 616e18e9-353d-41f2-914d-ce4362a07340

	measure 'Toplam Gider' = SUM('Gider Listesi'[TUTAR])
		formatString: "₺"#,0.00;-"₺"#,0.00;"₺"#,0.00
		lineageTag: 91002d06-73f7-4b0b-9798-563c28ebe611

		annotation PBI_FormatHint = {"currencyCulture":"tr-TR"}

	measure 'Kursiyer Basına Maaliyet' = DIVIDE([Toplam Gider],DISTINCTCOUNT('Kursiyer Listesi'[ADAY NO]),0)
		lineageTag: 155051b5-02ed-414e-aff4-abb44916ea6c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gecen Ay Maliyet/kursiyer' = ```
			
			CALCULATE(
			    [Kursiyer Basına Maaliyet], 
			    DATEADD(Takvim[Date],-1,MONTH))
			```
		formatString: 0
		lineageTag: 45bb8462-bf26-4a78-8cfe-7c18cfca0e88

	column SN
		dataType: int64
		formatString: 0
		lineageTag: 03bca676-0b46-4069-be46-7d8993da0e64
		summarizeBy: sum
		sourceColumn: SN

		annotation SummarizationSetBy = Automatic

	column TARİH
