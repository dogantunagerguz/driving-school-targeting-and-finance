	partition Takvim = calculated
		mode: import
		source =
				
				VAR BaslangicYili = 2020
				VAR BitisYili = 2027
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( DATE ( BaslangicYili, 1, 1 ), DATE ( BitisYili, 12, 31 ) ),
				    "Yıl", YEAR ( [Date] ),
				    "Ay No", MONTH ( [Date] ),
				    "Ay Adı", FORMAT ( [Date], "MMMM", "en-US" ),
				    "Çeyrek", "Q" & FORMAT ( [Date], "Q" ),
				    "Hafta No", WEEKNUM ( [Date] ),
				    "Gün Adı", FORMAT ( [Date], "dddd", "en-US" ),
				    "YılAy", FORMAT ( [Date], "YYYY-MM" )
				)

	annotation PBI_Id = c3daac38ba7b4f6086393701f2407a7a

