	column 'Certificate (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('Kursiyer Listesi'[Sertifika]),
				"(Blank)",
				'Kursiyer Listesi'[Sertifika] IN {"A1",
					"A1 Otomatik"},
				"A1 Group",
				'Kursiyer Listesi'[Sertifika] IN {"B",
					"B Otomatik"},
				"B Group",
				'Kursiyer Listesi'[Sertifika] IN {"C",
					"CE"},
				"C Group",
				'Kursiyer Listesi'[Sertifika]
			)
		lineageTag: 2efc33ab-1234-4f35-ab38-d1426dcd0c89
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
				  "groupedColumns": [
