				            "Entity": "Kursiyer Listesi"
				          }
				        },
				        "Property": "Sertifika"
				      }
				    }
				  ]
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"k","Entity":"Kursiyer Listesi"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"k"}},"Property":"Sertifika"}}],"GroupItems":[{"DisplayName":"(Blank)","BlankDefaultPlaceholder":true},{"DisplayName":"A1 Group","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"k"}},"Property":"Sertifika"}}],"Values":[[{"Literal":{"Value":"'A1'"}}],[{"Literal":{"Value":"'A1 Otomatik'"}}]]}}},{"DisplayName":"B Group","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"k"}},"Property":"Sertifika"}}],"Values":[[{"Literal":{"Value":"'B'"}}],[{"Literal":{"Value":"'B Otomatik'"}}]]}}},{"DisplayName":"C Group","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"k"}},"Property":"Sertifika"}}],"Values":[[{"Literal":{"Value":"'C'"}}],[{"Literal":{"Value":"'CE'"}}]]}}}]}

		annotation SummarizationSetBy = Automatic

	column Yaş =
			VAR BirthDate = 'Kursiyer Listesi'[D.TARİHİ]
			VAR AsOfDate = TODAY()
			VAR Years = YEAR(AsOfDate) - YEAR(BirthDate)
			VAR BirthdayPending =
			    MONTH(AsOfDate) < MONTH(BirthDate)
			        || (MONTH(AsOfDate) = MONTH(BirthDate) && DAY(AsOfDate) < DAY(BirthDate))
			RETURN
			    IF(
			        ISBLANK(BirthDate) || BirthDate > AsOfDate,
			        BLANK(),
			        Years - IF(BirthdayPending, 1, 0)
			    )
		formatString: 0
		lineageTag: 72527445-201a-4487-bc40-8cf9147db27a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Kursiyer Listesi","TableItemName":"Yaş (bins)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column 'Pazarlama Segmenti' = ```
			
			VAR MevcutYas = [Yaş]
			VAR ErkekMi = [Cinsiyet] = "E"
			VAR EgitimUygunMu = [ÖĞRENİM DURUMU] IN { "İlkokul", "Ortaokul", "Lise","İlköğretim","Mesleki-Teknik Lise","Yetişkinler 2.Kademe","Yüksekokul" }
			VAR B_var_mi = 'Kursiyer Listesi'[Sertifika] = "B"
			VAR A1_var_mi = 'Kursiyer Listesi'[Sertifika] IN { "A1", "A1 Otomatik" }
			VAR A2_var_mi = 'Kursiyer Listesi'[Sertifika] = "A2"
			VAR C_var_mi = 'Kursiyer Listesi'[Sertifika] = "C"
			RETURN
			
			SWITCH(
			    TRUE(),
			    -- Şart 1: Hem erkek, hem eğitimi uygun, hem de 21-23 yaş arası
			    ErkekMi && EgitimUygunMu && B_var_mi && MevcutYas >= 21 && MevcutYas <= 23, 
			        "Only C Potential",
			
			    -- Şart 2: Hem erkek, hem eğitimi uygun, hem de 24 yaş ve üstü
			    ErkekMi && EgitimUygunMu && B_var_mi && MevcutYas >= 24, 
			        "C-D Potential",
			
			    A1_var_mi && MevcutYas >= 17,
			        "B Potential",
			
			    A2_var_mi && MevcutYas >=20,
			        "A Potential",
			        
			    ErkekMi && EgitimUygunMu && C_var_mi && MevcutYas >= 24,
			        "CE Potential",
			        
			    -- Diğer tüm durumlar
			    "Out of Scope"
			)
			```
		lineageTag: 118207e7-3e4f-4ccb-93b6-59d9442d2058
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Yaş (bins)' =
			IF(
				ISBLANK('Kursiyer Listesi'[Yaş]),
				BLANK(),
				INT('Kursiyer Listesi'[Yaş] / 10) * 10
			)
		formatString: 0
		lineageTag: 3255d7ca-d53b-44cf-9563-18ae980e161e
		summarizeBy: none

