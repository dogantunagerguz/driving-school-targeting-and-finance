		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"k","Entity":"Kursiyer Listesi"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"k"}},"Property":"Yaş"}}],"BinItem":{"Expression":{"Floor":{"Expression":{"Column":{"Expression":{"SourceRef":{"Source":"k"}},"Property":"Yaş"}},"Size":10.0}}}}

